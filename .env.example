# WhatsApp business number in international format, no plus sign, no spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=9779800000000

# Site URL (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://aquarealmfish.com

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aquarealm2026

# Secret used to sign the admin session cookie - change this in production
ADMIN_SECRET=change-this-to-a-long-random-string

# --- Supabase (required — product data is stored here) ---
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Keep this one secret! Never expose it to the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (required — sends the signup email-verification code) ---
# Sign up free at https://resend.com, verify a sending domain (or use their
# onboarding@resend.dev sender for testing), then create an API key at
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain you've verified in Resend once you go live.
RESEND_FROM_EMAIL=Maccha Bazar <onboarding@resend.dev>
