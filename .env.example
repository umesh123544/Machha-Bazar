# WhatsApp business number in international format, no plus sign, no spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=9779800000000

# Site URL (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://machha-bazar.vercel.app

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aquarealm2026

# Secret used to sign the admin session cookie - change this in production
ADMIN_SECRET=change-this-to-a-long-random-string

# --- Supabase (required — product data is stored here) ---
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Keep this one secret! Never expose it to the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (required — sends the signup verification code) ---
# Pick ONE of the two options below.

# Option A — Gmail SMTP (FREE, no domain needed, sends to anyone):
# 1. Turn on 2-Step Verification on your Gmail account: myaccount.google.com/security
# 2. Create an "App Password": myaccount.google.com/apppasswords
#    (choose app "Mail", any device name) — copy the 16-character password.
# 3. Fill these in (GMAIL_APP_PASSWORD is the 16-char app password, NOT your normal Gmail password):
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
GMAIL_FROM_NAME=Maccha Bazar

# Option B — Resend (needs a verified domain to email real customers,
# otherwise it can only email your own Resend account address):
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Maccha Bazar <onboarding@resend.dev>
RESEND_REPLY_TO_EMAIL=machhabazar59@gmail.com
